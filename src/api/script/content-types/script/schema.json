{
  "kind": "collectionType",
  "collectionName": "scripts",
  "info": {
    "singularName": "script",
    "pluralName": "scripts",
    "displayName": "Script",
    "description": "Sales scripts library published to /scripts"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "content": {
      "type": "richtext"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "Cold Calling",
        "Objection Handling",
        "Follow-up",
        "Listing Presentation",
        "Buyer Consultation",
        "Expired Listings",
        "FSBO Scripts",
        "Door Knocking",
        "Sphere of Influence"
      ],
      "default": "Cold Calling",
      "required": true
    },
    "difficulty": {
      "type": "enumeration",
      "enum": ["Beginner", "Intermediate", "Advanced"],
      "default": "Intermediate",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["published", "draft"],
      "default": "published",
      "required": true
    },
    "useCase": {
      "type": "text"
    },
    "estimatedTime": {
      "type": "string"
    },
    "author": {
      "type": "string",
      "default": "Edi Shek"
    },
    "authorTitle": {
      "type": "string",
      "default": "NMLS# 216981"
    },
    "tags": {
      "type": "string"
    },
    "viewCount": {
      "type": "integer",
      "default": 0
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "aiAssisted": {
      "type": "boolean",
      "default": true
    },
    "thumbnail": {
      "allowedTypes": ["images"],
      "type": "media",
      "multiple": false
    },
    "metaTitle": {
      "type": "string"
    },
    "metaDescription": {
      "type": "text"
    },
    "canonicalUrl": {
      "type": "string"
    },
    "keywords": {
      "type": "string"
    },
    "ogTitle": {
      "type": "string"
    },
    "ogDescription": {
      "type": "text"
    },
    "ogImage": {
      "allowedTypes": ["images"],
      "type": "media",
      "multiple": false
    },
    "noIndex": {
      "type": "boolean",
      "default": false
    }
  }
}
