{
  "kind": "collectionType",
  "collectionName": "ctas",
  "info": {
    "singularName": "cta",
    "pluralName": "ctas",
    "displayName": "CTA Button",
    "description": "Call to action buttons for the frontend"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "label": {
      "type": "string"
    },
    "href": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "link",
        "modal"
      ],
      "default": "link"
    },
    "target": {
      "type": "string",
      "default": "_blank"
    },
    "action": {
      "type": "string"
    },
    "visible": {
      "type": "boolean",
      "default": true
    },
    "glow": {
      "type": "boolean",
      "default": false
    },
    "order": {
      "type": "integer"
    }
  }
}
