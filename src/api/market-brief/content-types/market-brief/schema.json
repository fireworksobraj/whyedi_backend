{
  "kind": "collectionType",
  "collectionName": "market_briefs",
  "info": {
    "singularName": "market-brief",
    "pluralName": "market-briefs",
    "displayName": "Market Brief (News)",
    "description": "Daily market briefs published to /news — generated from real industry sources"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": true
    },
    "content": {
      "type": "richtext"
    },
    "briefDate": {
      "type": "date"
    },
    "status": {
      "type": "enumeration",
      "enum": ["published", "draft"],
      "default": "published",
      "required": true
    },
    "author": {
      "type": "string",
      "default": "Edi Shek"
    },
    "authorTitle": {
      "type": "string",
      "default": "NMLS# 216981"
    },
    "readTime": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "default": "Daily Brief"
    },
    "tags": {
      "type": "string"
    },
    "sources": {
      "type": "json"
    },
    "keyStats": {
      "type": "json"
    },
    "viewCount": {
      "type": "integer",
      "default": 0
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "aiAssisted": {
      "type": "boolean",
      "default": true
    },
    "featuredImage": {
      "allowedTypes": ["images"],
      "type": "media",
      "multiple": false
    },
    "metaTitle": {
      "type": "string"
    },
    "metaDescription": {
      "type": "text"
    },
    "canonicalUrl": {
      "type": "string"
    },
    "keywords": {
      "type": "string"
    },
    "ogTitle": {
      "type": "string"
    },
    "ogDescription": {
      "type": "text"
    },
    "ogImage": {
      "allowedTypes": ["images"],
      "type": "media",
      "multiple": false
    },
    "noIndex": {
      "type": "boolean",
      "default": false
    }
  }
}
